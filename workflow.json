        "jsCode": "// RETAS MESIN: Membajak library bawaan 'lodash' untuk menyimpan memori\n// murni di dalam RAM karena versi n8n ini memblokir akses eksternal.\nconst _ = require('lodash');\n\n// 1. Buat brankas siluman jika belum ada di RAM\nif (!_.abmStatefulCache) {\n    _.abmStatefulCache = {};\n}\n\nconst targetUrl = $json.body.website;\nconst targetCompany = $json.body.company;\n\n// 2. Cek apakah URL sudah dikunci di dalam brankas RAM\nif (_.abmStatefulCache[targetUrl]) {\n    return [{ \n        json: { \n            status: \"DUPLICATE\", \n            url: targetUrl, \n            source: \"RAM Hijack Cache\" \n        } \n    }];\n}\n\n// 3. Jika belum ada, kunci URL ke dalam RAM (Instan, O(1) Time Complexity)\n_.abmStatefulCache[targetUrl] = true;\n\n// 4. Loloskan prospek baru\nreturn [{ \n    json: { \n        status: \"NEW_LEAD\", \n        url: targetUrl, \n        company: targetCompany \n    } \n}];"
      },
