# ==========================================
# 🚀 STATEFUL ABM ENGINE - ENVIRONMENT CONFIG
# ==========================================

# --- n8n Core Settings ---
N8N_HOST=abm.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_ENV=production
WEBHOOK_URL=https://abm.yourdomain.com/

# --- Redis Stateful Memory (Deduplication) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_password

# --- Groq / Llama-3 Intelligence ---
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.7

# --- SMTP Rotation Pool ---
SMTP_SENDER_1_HOST=smtp.workspace.google.com
SMTP_SENDER_1_USER=hello@yourdomain.com
SMTP_SENDER_1_PASS=app_password_here

SMTP_SENDER_2_HOST=smtp.office365.com
SMTP_SENDER_2_USER=ali@yourdomain.com
SMTP_SENDER_2_PASS=app_password_here
