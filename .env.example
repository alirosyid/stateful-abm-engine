# ==========================================
# ABM STATEFUL ENGINE - ENVIRONMENT SETTINGS
# ==========================================

# 1. AI Integration
# Dapatkan API Key gratis di: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# 2. SMTP Sender Rotation (Ganti dengan data riil di file .env lokal Anda)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_outreach_email@domain.com
SMTP_PASS=your_app_password

# 3. n8n Security (Wajib diaktifkan di production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=super_secure_password
